{
  "name": "opencode-harness-hooks",
  "version": "0.1.0",
  "description": "Native Claude Code and Codex hook compatibility for OpenCode",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./engine": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./opencode": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    }
  },
  "bin": {
    "opencode-harness-hooks": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "conformance/catalog.json",
    "conformance/README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:engine": "tsc -p tsconfig.engine.json",
    "build:v1": "tsc -p tsconfig.v1.json",
    "build:v2": "tsc -p tsconfig.v2.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=4",
    "conformance": "node scripts/verify-conformance.mjs",
    "test:host:v2": "node scripts/verify-v2.mjs",
    "test:host:v2:stop": "node scripts/verify-v2-stop.mjs",
    "test:host:plugin": "node scripts/verify-plugin.mjs",
    "test:native:claude": "node scripts/verify-claude-transcript.mjs",
    "test:native:claude:lifecycle": "node scripts/verify-claude-lifecycle.mjs",
    "test:native:stop": "node scripts/verify-native-stop.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "rregex": "1.12.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
