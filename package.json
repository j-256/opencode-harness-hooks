{
  "name": "opencode-harness-hooks",
  "version": "0.1.0",
  "description": "Native Claude Code and Codex hook compatibility for OpenCode",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "bin": {
    "opencode-harness-hooks": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "test:host:v2": "node scripts/verify-v2.mjs",
    "test:host:plugin": "node scripts/verify-plugin.mjs",
    "test:native:claude": "node scripts/verify-claude-transcript.mjs",
    "test:native:claude:lifecycle": "node scripts/verify-claude-lifecycle.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm run build && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "rregex": "1.12.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
