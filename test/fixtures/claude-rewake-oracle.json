      "automatic": true,
      "visible": [
        "BG_REWAKE_STDERR"
      ]
    },
    {
      "name": "-rewake-both",
      "async": true,
      "asyncRewake": true,
      "stdout": "{\"systemMessage\":\"BG_REWAKE_JSON\",\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"BG_REWAKE_CONTEXT\"}}",
      "stderr": "BG_REWAKE_STDERR",
      "exitCode": 2,
      "automatic": true,
      "visible": [
        "BG_REWAKE_STDERR"
      ]
    },
    {
      "name": "-rewake-stdout",
      "async": false,
      "asyncRewake": true,
      "stdout": "{\"systemMessage\":\"BG_REWAKE_JSON\",\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"BG_REWAKE_CONTEXT\"}}",
      "stderr": "",
      "exitCode": 2,
      "automatic": true,
      "visible": [
        "BG_REWAKE_JSON",
        "BG_REWAKE_CONTEXT"
      ]
    },
    {
      "name": "-rewake-success",
      "async": false,
      "asyncRewake": true,
